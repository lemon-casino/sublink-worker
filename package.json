{
  "name": "sublink-worker",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:assets && node scripts/build-vercel.mjs",
    "deploy": "npm run build:assets && npm run setup-kv && wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "setup-kv": "node scripts/setup-kv.cjs",
    "build:node": "npm run build:assets && esbuild src/platforms/node-server.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/node-server.cjs",
    "dev:node": "npm run build:node && node dist/node-server.cjs",
    "build:assets": "node scripts/build-assets.mjs",
    "predev": "npm run build:assets",
    "prestart": "npm run build:assets"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "alpinejs": "^3.17.5",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "esbuild-register": "^3.6.0",
    "hono": "^4.13.16",
    "ioredis": "^5.8.2",
    "js-yaml": "^4.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
